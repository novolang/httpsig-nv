// ── Helpers ──────────────────────────────────────────────────────────

fn joined(ls: [Str]) -> Str
    str.join(ls, "\n")

// The header fields of a message printed as an RFC does: the start line,
// then `Name: value` lines.
fn headers_of(lines: [Str]) -> [HsigField]
    var out: [HsigField] = []
    for i in 1..list.len(lines)
        let l = lines[i]
        match str.index(l, ": ")
            Some(k) => list.push(out, hsigtypes.field(str.slice(l, 0, k), str.slice(l, k + 2, str.len(l))))
            None    => ()
    out

// The value of the first field with a name, in lower case.
fn header_value(lines: [Str], name: Str) -> Str
    for f in headers_of(lines)
        if str.lower(f.name) == name
            return f.value
    ""

// The values of every field with a name.
fn header_values(lines: [Str], name: Str) -> [Str]
    hsigmsg.field_lines(headers_of(lines), name)

// A request from its printed form: the method and target are on the first
// line and the authority is the Host field.
fn request_of(lines: [Str]) -> HsigMessage
    let parts = str.split(lines[0], " ")
    match hsigmsg.request(parts[0], "https://" + header_value(lines, "host") + parts[1], headers_of(lines))
        Ok(m)  => m
        Err(_) => hsigtypes.response(0, [])

// A response from its printed form.
fn response_of(lines: [Str]) -> HsigMessage
    let parts = str.split(lines[0], " ")
    hsigtypes.response(str.to_int(parts[1]) ?? 0, headers_of(lines))

// Bytes from base64 text in the URL alphabet, without padding.
fn from_b64url(s: Str) -> Bytes
    var t = str.replace_all(str.replace_all(s, "-", "+"), "_", "/")
    while str.len(t) % 4 != 0
        t = t + "="
    bytes.from_base64(t) ?? bytes.zeros(0)

// Bytes from standard base64 text.
fn from_b64(s: Str) -> Bytes
    bytes.from_base64(s) ?? bytes.zeros(0)

// The signature bytes of one label in the `Signature` field of a message.
fn signature_bytes(lines: [Str], label: Str) -> Bytes
    match hsigfields.parse_signature(header_values(lines, "signature"))
        Err(_) => bytes.zeros(0)
        Ok(es) =>
            match hsigfields.find_signature(es, label)
                None    => bytes.zeros(0)
                Some(e) => bytes.clone(e.signature)

// The error code of a failed verification, or 0 when it succeeded.
fn verify_code(msg: HsigMessage, lines: [Str], label: Str, key: HsigVerifyKey) -> Int
    match httpsig.verify(msg,
        None,
        header_values(lines, "signature-input"),
        header_values(lines, "signature"),
        label,
        key)
        Ok(_)  => 0
        Err(e) => e.code

fn secret_key() -> Bytes
    from_b64(shared_secret_b64())

fn ed_signing() -> HsigKey
    HsigEd25519Key(from_b64url(ed_seed_b64u()))

fn ed_verifying() -> HsigVerifyKey
    HsigEd25519VerifyKey(from_b64url(ed_pub_b64u()))

fn ecc_signing() -> HsigKey
    HsigEcdsaP256Key(from_b64url(p256_d_b64u()))

fn ecc_verifying() -> HsigVerifyKey
    HsigEcdsaP256VerifyKey(from_b64url(p256_x_b64u()), from_b64url(p256_y_b64u()))

fn rsa_verifying() -> HsigVerifyKey
    HsigRsaV15VerifyKey(from_b64url(rsa_n_b64u()), from_b64url(rsa_e_b64u()))

// The covered components of a vector as the RFC lists them, from the
// Signature-Input line printed in the RFC.
fn input_entry(hdr: [Str], label: Str) -> HsigInputEntry
    match hsigfields.parse_signature_input([header_value(hdr, "signature-input")])
        Err(_) => HsigInputEntry { label: "", components: [], params: [] }
        Ok(es) =>
            match hsigfields.find_input(es, label)
                None    => HsigInputEntry { label: "", components: [], params: [] }
                Some(e) => e

fn str_param(key: Str, v: Str) -> SfvParam
    sfvtypes.param(key, SfvString(v))

fn int_param(key: Str, v: Int) -> SfvParam
    sfvtypes.param(key, SfvInteger(v))

// ── B.2.1, B.2.2, B.2.3: rsa-pss-sha512 ──────────────────────────────

@test
fn test_b21_minimal_signature_covers_nothing_but_its_parameters()
    let msg = request_of(request_msg())
    let params = [int_param("created", 1618884473),
        str_param("keyid", "test-key-rsa-pss"),
        str_param("nonce", "b3k2pp5k7z-50gnwp.yemd")]

    test.case("the signature base is the parameters line alone")
    test.assert(hsigbase.signature_base(msg, None, [], params) == Ok(joined(b21_base())))

    test.case("the Signature-Input member is the RFC's")
    test.assert(hsigfields.input_member("sig-b21", [], params) == Ok(header_value(b21_hdr(), "signature-input")))

    test.case("the RFC's Signature-Input field reads back to the same components and parameters")
    let e = input_entry(b21_hdr(), "sig-b21")
    test.assert(list.len(e.components) == 0)
    test.assert(hsigbase.signature_base(msg, None, e.components, e.params) == Ok(joined(b21_base())))

@test
fn test_b22_selective_components_with_a_query_parameter()
    let msg = request_of(request_msg())
    let comps = [hsigtypes.component("@authority"),
        hsigtypes.component("content-digest"),
        hsigtypes.component_query_param("Pet")]
    let params = [int_param("created", 1618884473),
        str_param("keyid", "test-key-rsa-pss"),
        str_param("tag", "header-example")]

    test.case("the signature base")
    test.assert(hsigbase.signature_base(msg, None, comps, params) == Ok(joined(b22_base())))

    test.case("the Signature-Input member")
    test.assert(hsigfields.input_member("sig-b22", comps, params) == Ok(header_value(b22_hdr(), "signature-input")))

    test.case("read back from the RFC's field")
    let e = input_entry(b22_hdr(), "sig-b22")
    test.assert(list.len(e.components) == 3)
    test.assert(hsigbase.signature_base(msg, None, e.components, e.params) == Ok(joined(b22_base())))

@test
fn test_b23_full_coverage_of_the_request()
    let msg = request_of(request_msg())
    let comps = [hsigtypes.component("date"),
        hsigtypes.component("@method"),
        hsigtypes.component("@path"),
        hsigtypes.component("@query"),
        hsigtypes.component("@authority"),
        hsigtypes.component("content-type"),
        hsigtypes.component("content-digest"),
        hsigtypes.component("content-length")]
    let params = [int_param("created", 1618884473), str_param("keyid", "test-key-rsa-pss")]

    test.case("the signature base")
    test.assert(hsigbase.signature_base(msg, None, comps, params) == Ok(joined(b23_base())))

    test.case("the Signature-Input member")
    test.assert(hsigfields.input_member("sig-b23", comps, params) == Ok(header_value(b23_hdr(), "signature-input")))

@test
fn test_b21_to_b23_signatures_are_not_checked_and_say_so()
    test.case("no key of this package is rsa-pss-sha512")
    test.assert(hsigalg.alg_of_verify_key(rsa_verifying()) == "rsa-v1_5-sha256")
    let e = input_entry(b22_hdr(), "sig-b22")
    test.assert(hsigfields.alg(e.params) == None)
    test.assert(hsigfields.keyid(e.params) == Some("test-key-rsa-pss"))
    test.assert(hsigfields.tag(e.params) == Some("header-example"))
    test.case("the RFC's signature is a 256-byte value")
    test.assert(bytes.len(signature_bytes(b22_hdr(), "sig-b22")) == 256)

// ── B.2.4: ecdsa-p256-sha256 on a response ───────────────────────────

@test
fn test_b24_response_signed_with_ecdsa()
    let msg = response_of(response_msg())
    let comps = [hsigtypes.component("@status"),
        hsigtypes.component("content-type"),
        hsigtypes.component("content-digest"),
        hsigtypes.component("content-length")]
    let params = [int_param("created", 1618884473), str_param("keyid", "test-key-ecc-p256")]

    test.case("the signature base and the Signature-Input member")
    test.assert(hsigbase.signature_base(msg, None, comps, params) == Ok(joined(b24_base())))
    test.assert(hsigfields.input_member("sig-b24", comps, params) == Ok(header_value(b24_hdr(), "signature-input")))

    test.case("the RFC's signature verifies against the public key")
    test.assert(hsigalg.verify(joined(b24_base()), signature_bytes(b24_hdr(), "sig-b24"), ecc_verifying()) == Ok(true))

    test.case("a signature made here verifies, and is 64 bytes")
    match httpsig.sign(msg, None, "sig-b24", comps, params, ecc_signing())
        Err(_) => test.fail("signing")
        Ok(s)  =>
            test.assert(bytes.len(s.value) == 64)
            test.assert(s.signature_input == header_value(b24_hdr(), "signature-input"))
            test.assert(hsigalg.verify(s.base, s.value, ecc_verifying()) == Ok(true))

    test.case("a changed base does not verify")
    test.assert(hsigalg.verify(joined(b24_base()) + "x", signature_bytes(b24_hdr(), "sig-b24"), ecc_verifying()) == Ok(false))

// ── B.2.5: hmac-sha256 ───────────────────────────────────────────────

@test
fn test_b25_hmac_signature_equals_the_rfc()
    let msg = request_of(request_msg())
    let comps = [hsigtypes.component("date"),
        hsigtypes.component("@authority"),
        hsigtypes.component("content-type")]
    let params = [int_param("created", 1618884473), str_param("keyid", "test-shared-secret")]

    test.case("the signature made here is the RFC's, byte for byte")
    match httpsig.sign(msg, None, "sig-b25", comps, params, HsigHmacKey(secret_key()))
        Err(_) => test.fail("signing")
        Ok(s)  =>
            test.assert(s.base == joined(b25_base()))
            test.assert(s.signature_input == header_value(b25_hdr(), "signature-input"))
            test.assert(s.signature == header_value(b25_hdr(), "signature"))
            test.assert(s.value == signature_bytes(b25_hdr(), "sig-b25"))

    test.case("the RFC's fields verify with the shared secret")
    test.assert(verify_code(msg, b25_hdr(), "sig-b25", HsigHmacVerifyKey(secret_key())) == 0)

    test.case("a different secret does not")
    test.assert(verify_code(msg, b25_hdr(), "sig-b25", HsigHmacVerifyKey(bytes.from_str("another secret"))) == HSIG_ERR_VERIFY_FAILED)

// ── B.2.6: ed25519 ───────────────────────────────────────────────────

@test
fn test_b26_ed25519_signature_equals_the_rfc()
    let msg = request_of(request_msg())
    let comps = [hsigtypes.component("date"),
        hsigtypes.component("@method"),
        hsigtypes.component("@path"),
        hsigtypes.component("@authority"),
        hsigtypes.component("content-type"),
        hsigtypes.component("content-length")]
    let params = [int_param("created", 1618884473), str_param("keyid", "test-key-ed25519")]

    test.case("the signature made here is the RFC's, byte for byte")
    match httpsig.sign(msg, None, "sig-b26", comps, params, ed_signing())
        Err(_) => test.fail("signing")
        Ok(s)  =>
            test.assert(s.base == joined(b26_base()))
            test.assert(s.signature_input == header_value(b26_hdr(), "signature-input"))
            test.assert(s.signature == header_value(b26_hdr(), "signature"))

    test.case("the RFC's fields verify with the public key")
    test.assert(verify_code(msg, b26_hdr(), "sig-b26", ed_verifying()) == 0)

// ── B.3: a proxy signs a Client-Cert field ───────────────────────────

@test
fn test_b3_tls_terminating_proxy()
    let unsigned = request_of(b3_unsigned())
    let comps = [hsigtypes.component("@path"),
        hsigtypes.component("@query"),
        hsigtypes.component("@method"),
        hsigtypes.component("@authority"),
        hsigtypes.component("client-cert")]
    let params = [int_param("created", 1618884473), str_param("keyid", "test-key-ecc-p256")]

    test.case("the signature base")
    test.assert(hsigbase.signature_base(unsigned, None, comps, params) == Ok(joined(b3_base())))

    test.case("the signed request verifies from its own fields")
    let signed = request_of(b3_signed())
    test.assert(verify_code(signed, b3_signed(), "ttrp", ecc_verifying()) == 0)

    test.case("the signature printed beside the base is the one in the field")
    test.assert(signature_bytes(b3_signed(), "ttrp") == from_b64(joined(b3_sig())))

// ── B.4: transformations ─────────────────────────────────────────────

fn b4_variant(lines: [Str]) -> Int
    verify_code(request_of(lines), lines, "transform", ed_verifying())

@test
fn test_b4_the_signature_base_of_the_signed_message()
    test.case("the base")
    let msg = request_of(b4_msg())
    let e = input_entry(b4_msg(), "transform")
    test.assert(hsigbase.signature_base(msg, None, e.components, e.params) == Ok(joined(b4_base())))
    test.case("the signature verifies")
    test.assert(b4_variant(b4_msg()) == 0)

@test
fn test_b4_changes_that_leave_the_signature_valid()
    let sig_in = header_value(b4_msg(), "signature-input")
    let sig = header_value(b4_msg(), "signature")
    let ed = "Signature-Input: " + sig_in
    let es = "Signature: " + sig

    test.case("an added header field and an added query parameter")
    let added = ["GET /demo?name1=Value1&Name2=value2&param=added HTTP/1.1",
        "Host: example.org",
        "Date: Fri, 15 Jul 2022 14:24:55 GMT",
        "Accept: application/json",
        "Accept: */*",
        "Accept-Language: en-US,en;q=0.5",
        ed,
        es]
    test.assert(b4_variant(added) == 0)

    test.case("a removed Date, an added Referer, and the two Accept fields collapsed into one")
    let collapsed = ["GET /demo?name1=Value1&Name2=value2 HTTP/1.1",
        "Host: example.org",
        "Referer: https://developer.example.org/demo",
        "Accept: application/json, */*",
        ed,
        es]
    test.assert(b4_variant(collapsed) == 0)

    test.case("the fields reordered, the two Accept fields kept in order")
    let reordered = ["GET /demo?name1=Value1&Name2=value2 HTTP/1.1",
        "Accept: application/json",
        "Accept: */*",
        "Date: Fri, 15 Jul 2022 14:24:55 GMT",
        "Host: example.org",
        ed,
        es]
    test.assert(b4_variant(reordered) == 0)

@test
fn test_b4_changes_that_break_the_signature()
    let sig_in = header_value(b4_msg(), "signature-input")
    let sig = header_value(b4_msg(), "signature")
    let ed = "Signature-Input: " + sig_in
    let es = "Signature: " + sig

    test.case("the method changed to POST and the authority to example.com")
    let changed = ["POST /demo?name1=Value1&Name2=value2 HTTP/1.1",
        "Host: example.com",
        "Date: Fri, 15 Jul 2022 14:24:55 GMT",
        "Accept: application/json",
        "Accept: */*",
        ed,
        es]
    test.assert(b4_variant(changed) == HSIG_ERR_VERIFY_FAILED)

    test.case("the two Accept fields swapped")
    let swapped = ["GET /demo?name1=Value1&Name2=value2 HTTP/1.1",
        "Host: example.org",
        "Date: Fri, 15 Jul 2022 14:24:55 GMT",
        "Accept: */*",
        "Accept: application/json",
        ed,
        es]
    test.assert(b4_variant(swapped) == HSIG_ERR_VERIFY_FAILED)

// ── Section 4.3: two signatures on one message ───────────────────────

@test
fn test_section_4_3_the_clients_ecdsa_signature()
    let msg = request_of(m43_client())
    test.case("the client's own message verifies under its label")
    test.assert(verify_code(msg, m43_client(), "sig1", ecc_verifying()) == 0)
    test.case("and the label that is not there is not found")
    test.assert(verify_code(msg, m43_client(), "proxy_sig", rsa_verifying()) == HSIG_ERR_NO_SIGNATURE_INPUT)

@test
fn test_section_4_3_the_proxys_rsa_signature_among_two()
    let msg = request_of(m43_forwarded())

    test.case("the proxy's base, from the Signature-Input entry that carries its label")
    match hsigfields.parse_signature_input(header_values(m43_forwarded(), "signature-input"))
        Err(_) => test.fail("parse")
        Ok(es) =>
            test.assert(list.len(es) == 2)
            match hsigfields.find_input(es, "proxy_sig")
                None    => test.fail("proxy_sig")
                Some(e) =>
                    test.assert(hsigbase.signature_base(msg, None, e.components, e.params) == Ok(joined(m43_proxy_base())))
                    test.assert(hsigfields.alg(e.params) == Some("rsa-v1_5-sha256"))
                    test.assert(hsigfields.expires(e.params) == Some(1618884540))

    test.case("the RSASSA-PKCS1-v1_5 signature verifies")
    test.assert(verify_code(msg, m43_forwarded(), "proxy_sig", rsa_verifying()) == 0)
    test.assert(signature_bytes(m43_forwarded(), "proxy_sig") == from_b64(joined(m43_proxy_sig())))

    test.case("the client's signature, made over another authority, no longer verifies")
    test.assert(verify_code(msg, m43_forwarded(), "sig1", ecc_verifying()) == HSIG_ERR_VERIFY_FAILED)

    test.case("the alg parameter must be the key's")
    test.assert(verify_code(msg, m43_forwarded(), "proxy_sig", ecc_verifying()) == HSIG_ERR_ALG_MISMATCH)

// ── Section 2.4: a response that signs parts of its request ──────────

// The error code of a failed verification of a response against its request.
fn verify_code_req(msg: HsigMessage, req: ?HsigMessage, lines: [Str], label: Str,
                   key: HsigVerifyKey) -> Int
    match httpsig.verify(msg,
        req,
        header_values(lines, "signature-input"),
        header_values(lines, "signature"),
        label,
        key)
        Ok(_)  => 0
        Err(e) => e.code

@test
fn test_section_2_4_the_response_covers_the_method_authority_path_and_digest_of_its_request()
    let req = request_of(r24_request())
    let resp = response_of(r24_signed())

    test.case("the signature base, with req components read from the request")
    match httpsig.prepare(resp,
        Some(req),
        header_values(r24_signed(), "signature-input"),
        header_values(r24_signed(), "signature"),
        "reqres")
        Err(_) => test.fail("prepare")
        Ok(p)  =>
            test.assert(p.base == joined(r24_base()))
            test.assert(list.len(p.components) == 7)

    test.case("the RFC's signature verifies")
    test.assert(verify_code_req(resp, Some(req), r24_signed(), "reqres", ecc_verifying()) == 0)

    test.case("without the request the req components cannot be read")
    test.assert(verify_code_req(resp, None, r24_signed(), "reqres", ecc_verifying()) == HSIG_ERR_NO_REQUEST)

    test.case("a different request does not verify")
    let other = request_of(["POST /bar?param=Value&Pet=dog HTTP/1.1",
        "Host: example.com",
        "Content-Digest: " + header_value(r24_request(), "content-digest")])
    test.assert(verify_code_req(resp, Some(other), r24_signed(), "reqres", ecc_verifying()) == HSIG_ERR_VERIFY_FAILED)

    test.case("a signature made here over the same components has the RFC's base and verifies")
    let comps = [hsigtypes.component("@status"),
        hsigtypes.component("content-digest"),
        hsigtypes.component("content-type"),
        hsigtypes.component_flag("@authority", "req"),
        hsigtypes.component_flag("@method", "req"),
        hsigtypes.component_flag("@path", "req"),
        hsigtypes.component_flag("content-digest", "req")]
    let params = [int_param("created", 1618884479), str_param("keyid", "test-key-ecc-p256")]
    match httpsig.sign(resp, Some(req), "reqres", comps, params, ecc_signing())
        Err(_) => test.fail("sign")
        Ok(s)  =>
            test.assert(s.base == joined(r24_base()))
            test.assert(s.signature_input == header_value(r24_signed(), "signature-input"))
            test.assert(hsigalg.verify(s.base, s.value, ecc_verifying()) == Ok(true))

@test
fn test_section_2_4_a_response_to_a_signed_request_covers_the_request_query_and_headers()
    let req = request_of(r24_signed_request())
    let resp = response_of(r24_signed2())
    test.case("the base")
    match httpsig.prepare(resp,
        Some(req),
        header_values(r24_signed2(), "signature-input"),
        header_values(r24_signed2(), "signature"),
        "reqres")
        Err(_) => test.fail("prepare")
        Ok(p)  => test.assert(p.base == joined(r24_base2()))
    test.case("the signature verifies")
    test.assert(verify_code_req(resp, Some(req), r24_signed2(), "reqres", ecc_verifying()) == 0)

@test
fn test_req_on_a_request_is_an_error()
    let req = request_of(r24_request())
    match hsigbase.component_value(req, None, hsigtypes.component_flag("@method", "req"))
        Ok(_)  => test.fail("accepted")
        Err(e) => test.assert(e.code == HSIG_ERR_REQ_ON_REQUEST)
